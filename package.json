{
  "name": "vaso",
  "version": "0.4.0",
  "description": "Glass effect for React",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm build && (bunchee --watch --no-clean & devjar dev site)",
    "build": "rm -rf dist && bunchee",
    "build:site": "pnpm build && devjar build site --origin https://vaso-react.vercel.app",
    "start:site": "devjar start site/dist",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huozhi/vaso.git"
  },
  "author": "huozhi",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@react-spring/web": "^10.0.1",
    "@types/node": "24.0.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "bunchee": "^6.5.4",
    "clsx": "^2.1.1",
    "devjar": "^1.1.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  }
}
